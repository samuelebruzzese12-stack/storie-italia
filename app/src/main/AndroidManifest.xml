<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Internet serve solo per scaricare il "cervello" AI e inviare le segnalazioni. L'AI funziona offline. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Voce narrante: da Android 11 serve per trovare il motore di sintesi vocale del telefono. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:label="Storie d'Italia"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:largeHeap="true"
        android:allowBackup="true"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_rules"
        android:enableOnBackInvokedCallback="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode|density"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Condivisione dell'immagine del finale (solo lettura, solo su richiesta dell'utente) -->
        <provider
            android:name=".ImmaginiProvider"
            android:authorities="${applicationId}.condividi"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
