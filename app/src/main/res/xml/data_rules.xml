<?xml version="1.0" encoding="utf-8"?>
<!-- I file dei modelli AI (GB) non vanno nel backup: si riscaricano. Le storie salvate sì. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="external" path="models/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="external" path="models/" />
    </device-transfer>
</data-extraction-rules>
